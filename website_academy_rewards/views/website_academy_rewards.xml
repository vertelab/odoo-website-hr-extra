<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <!-- Layout add nav and footer -->
        <template id="footer_custom" inherit_id="website.footer_custom" name="Footer Rewardees Link Custom">
            <xpath expr="//li[a[@href='/contactus']]" position="after">
                <li><a href="/rewardees">Our Rewardees</a></li>
            </xpath>
        </template>

        <template id="footer_custom" inherit_id="website.template_footer_minimalist" name="Footer Rewardees Link Minimalist">
            <xpath expr="//li[a[@href='/contactus']]" position="after">
                <li><a href="/rewardees">Our Rewardees</a></li>
            </xpath>
        </template>

        <!-- ===================== REWARDEES INDEX ===================== -->
        <template id="index_rewardees" name="Our Rewardee">
            <t t-name="website_academy_rewards.index_rewardees">
                <t t-call="website.layout">

                    <!-- STYLE: samma utseende som övriga sidor -->
                    <style>
                        /* Ikoner */
                        #ref_left_column .fa {
                            color: #fa0 !important;
                        }

                        /* Länkar  */
                        #ref_left_column a,
                        #ref_left_column a:visited {
                            color: #4f86c6 !important;
                            font-weight: 500;
                            text-decoration: none;
                        }

                        #ref_left_column a:hover {
                            color: #2f5f9f !important;
                            text-decoration: underline;
                        }

                        /* Rubriker vänster */
                        #ref_left_column h2,
                        #ref_left_column h1 {
                            color: #369 !important;
                        }

                        /* Rubriker höger */
                        #ref_content h1 {
                            color: #369 !important;
                        }
                        #ref_content h4 span {
                            color: #369 !important;
                        }
                        .breadcrumb-alla,
                        .breadcrumb-alla:visited {
                            color: #4f86c6 !important;
                            text-decoration: none;
                        }
                        .breadcrumb-alla:hover {
                            color: #2f5f9f !important;
                            text-decoration: underline;
                        }

                    </style>


                    <div id="wrap">
                        <div class="oe_structure"/>
                        <div class="container outer-clear">
                            <div class="row">

                                <!-- LEFT COLUMN -->
                                <div class="col-md-3 col-sm-12 col-xs-12" id="ref_left_column">
                                    <div class="col-md-12">
                                        <h2 class="text-center">Utmärkelser</h2>

                                        <t t-foreach="rewards" t-as="r">
                                            <ul class="list-unstyled">
                                                <li>
                                                    <h4>
                                                        <i class="fa fa-trophy"/>
                                                        <a t-att-href="'/reward/%s' % r.id">
                                                            <span t-field="r.name"/>
                                                        </a>
                                                    </h4>
                                                </li>
                                            </ul>
                                        </t>

                                        <ul class="list-unstyled">
                                            <li>
                                                <h4>
                                                    <i class="fa fa-bookmark"/>
                                                    <a href="/blog/evenemang-5">Hagdahlsföredrag</a>
                                                </h4>
                                            </li>
                                        </ul>

                                        <h2 class="text-center mt32">År</h2>

                                        <t t-foreach="rewards.get_years()" t-as="y">
                                            <t t-if="y">
                                                <ul class="list-unstyled">
                                                    <li>
                                                        <h4>
                                                            <i class="fa fa-calendar"/>
                                                            <a t-att-href="'/reward/year/%s' % y">
                                                                <span t-esc="y"/>
                                                            </a>
                                                        </h4>
                                                    </li>
                                                </ul>
                                            </t>
                                        </t>
                                    </div>

                                    <!-- MAP -->
                                    <div class="col-md-12" style="margin-top:10px; padding:0;">
                                        <section id="google-map">
                                            <div class="container box outer-clear" style="width:100%; margin:auto; padding:0;">
                                                <div class="col-md-12 inner-clear" id="map-google" style="height:275px;"/>
                                            </div>
                                        </section>
                                    </div>
                                </div>

                                <!-- RIGHT COLUMN -->
                                <div class="col-md-9 col-sm-12 col-xs-12" id="ref_content">
                                    <div class="container">


                                            <h1 class="text-center">Våra Pristagare</h1>


                                        <t t-if="reward">
                                            <h4 class="text-center">
                                                <hr style="display:inline-block;width:10%;margin-right:1%"/>
                                                <span t-esc="reward.name"/>
                                                <hr style="display:inline-block;width:10%;margin-left:1%"/>
                                            </h4>
                                        </t>

                                        <!--
                                        <t t-if="year">
                                            <h4 class="text-center">
                                                <hr style="display:inline-block;width:10%;margin-right:1%"/>
                                                <span t-esc="year"/>
                                                <hr style="display:inline-block;width:10%;margin-left:1%"/>
                                            </h4>
                                        </t>
                                        -->

                                        <t t-foreach="rewardees" t-as="r">
                                            <div class="col-md-12">
                                                <div class="col-md-6 mt16">
                                                    <div t-field="r.partner_id.image_1920"
                                                         t-options="{'widget':'image','class':'w-100 rounded-3 border'}"/>
                                                </div>

                                                <div class="col-md-6 mb32">
                                                    <a t-att-href="'/rewardee/%s' % r.id">
                                                        <h2 t-field="r.partner_id.name"/>
                                                    </a>

                                                    <p>
                                                        <i class="fa fa-trophy"/>
                                                        <strong>
                                                            <t t-esc="r.reward_id.name"/> – <t t-esc="r.reward_year"/>
                                                        </strong>
                                                    </p>

                                                    <t t-if="r.partner_id.child_ids">
                                                        <t t-foreach="r.partner_id.child_ids" t-as="rc">
                                                            <p><i class="fa fa-user"/> <t t-esc="rc.name"/></p>
                                                        </t>
                                                    </t>

                                                    <t t-set="attach" t-value="request.env['ir.attachment'].sudo().search([('res_id','=',r.id)])"/>
                                                    <t t-foreach="attach" t-as="a">
                                                        <ul>
                                                            <li>
                                                                <i class="fa fa-file-o"/>
                                                                <a t-att-href="'/attachment/%s/%s' % (a.id, a.name)">
                                                                    <span t-field="a.name"/>
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </t>

                                                    <p t-if="r.partner_id.rewardee_ids.comment">
                                                        <i class="fa fa-quote-left"/>
                                                        <t t-esc="r.partner_id.rewardee_ids.comment"/>
                                                        <i class="fa fa-quote-right"/>
                                                    </p>
                                                </div>
                                            </div>
                                        </t>
                                            <t t-if="reward">
                                            <span t-esc="reward.description"/>
                                             </t>
                                                  <ol class="breadcrumb mt32">
                                                    <li class="active">
                                                        <a href="/rewardees" class="breadcrumb-alla">Alla</a>

                                                    </li>

                                                    <t t-if="reward">
                                                        <li class="active">
                                                            <span> &#160;/ </span>
                                                            <span t-esc="reward.name"/>
                                                        </li>
                                                    </t>
                                                </ol>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="oe_structure"/>
                    </div>

                </t>
            </t>
        </template>


        <!-- rewardee form view -->
        <record id="view_rewardee_form" model="ir.ui.view">
            <field name="name">academy.rewardee.form</field>
            <field name="model">academy.rewardee</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Prize">
                    <group colspan="4" col="4">
                        <field name="partner_id" colspan="2"/>
                        <field name="sequence_rewardee" colspan="2"/>
                    </group>
                    <group colspan="4" col="4">
                        <field name="reward_year" colspan="2"/>
                        <field name="reward_id" colspan="2"/>
                    </group>
                    <group colspan="4" col="4">
                        <field name="comment" colspan="4"/>
                    </group>
                </form>
            </field>
        </record>

        <!-- rewardee list view -->
        <record id="view_rewardee_list" model="ir.ui.view">
            <field name="name">academy.rewardee.list</field>
            <field name="model">academy.rewardee</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Prize">
                    <field name="sequence_rewardee" widget="handle"/>
                    <field name="partner_id"/>
                    <field name="reward_year"/>
                    <field name="reward_id"/>
                    <field name="comment"/>
                </list>
            </field>
        </record>

        <!-- reward form view -->
        <record id="view_reward_form" model="ir.ui.view">
            <field name="name">academy.reward.form</field>
            <field name="model">academy.reward</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Prize">
                    <group colspan="4" col="4">
                        <field name="name" colspan="2"/>
                        <field name="sequence_reward" colspan="2"/>
                    </group>
                    <group colspan="4" col="4">
                        <field name="rewardee_ids" colspan="4"/>
                    </group>
                    <group colspan="4" col="4">
                        <field name="description" colspan="4"/>
                    </group>
                </form>
            </field>
        </record>

        <!-- reward list view -->
        <record id="view_reward_list" model="ir.ui.view">
            <field name="name">academy.reward.list</field>
            <field name="model">academy.reward</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Prize">
                    <field name="sequence_reward" widget="handle"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- increase fields in res.partner -->
        <record id="view_partner_form" model="ir.ui.view">
            <field name="name">res.partner.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <field name="website" position="after">
                    <field name="rewardee_ids" widget="many2many_tags"/>
                </field>
            </field>
        </record>

        <!-- increase sequence fields in res.partner -->
<!--
        <record id="view_partner_tree" model="ir.ui.view">
            <field name="name">res.partner.tree</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">
                <list string="Contacts">
                    <field name="display_name" position="after">
                        <field name="sequence_rewardee" widget="handle"/>
                    </field>
                </list>
            </field>
        </record>
-->

        <!-- blog post form view  -->
        <record model="ir.ui.view" id="view_blog_post_form">
            <field name="name">blog.post.form</field>
            <field name="model">blog.post</field>
            <field name="inherit_id" ref="website_blog.view_blog_post_form"/>
            <field name="arch" type="xml">
                <field name="blog_id" position="after">
                    <field name="partner_ids" widget="many2many_tags"/>
                </field>
            </field>
        </record>

        <template id="prize_winners_show_in_website" name="Prize winners show in website">
            <div class="container mb16" style="max-width: 1120px; padding: 0px;">
                <div style="margin: auto;">
                    <div class="grid js-masonry" style="">
                        <t t-set="winner" t-value="request.env['academy.rewardee'].sudo().search([('reward_id', '!=', '')])"/>
                        <t t-foreach="winner" t-as="w">
                            <div class="col-md-3 col-sm-4 col-12 grid-item" style="">
                                <a href="#" t-att-title="w.name" t-att-reward="w.reward_id.name" t-att-comment="w.comment">
                                    <span t-field="w.sudo().partner_id.image_1920" t-field-options="{&quot;widget&quot;: &quot;image&quot;, &quot;style&quot;: &quot;margin: auto&quot;, &quot;class&quot;: &quot;thumbnail img-thumbnail&quot;}"/>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </template>

        <!-- rewardee action window -->
       <record id="action_rewardee_all_view" model="ir.actions.act_window">
          <field name="name">Academy Rewardee</field>
          <field name="res_model">academy.rewardee</field>
          <!-- <field name="view_type">form</field> -->
          <field name="view_mode">list,form</field>
          <field name="view_id" ref="view_rewardee_list" />
          <field name="context">{"search_default_current": 1}</field>
        </record>

        <!-- reward action window -->
        <record id="action_reward_all_view" model="ir.actions.act_window">
          <field name="name">Academy Reward</field>
          <field name="res_model">academy.reward</field>
          <!-- <field name="view_type">form</field> -->
          <field name="view_mode">list,form</field>
          <field name="view_id" ref="view_reward_list" />
          <field name="context">{"search_default_current": 1}</field>
        </record>
        <menuitem id="menu_rewardee_all_menu" name="Reward Menu" sequence="100" />
        <menuitem id="menu_rewardee_all_view" name="Rewardee" parent="menu_rewardee_all_menu" sequence="100" action="action_rewardee_all_view" />
        <menuitem id="menu_reward_all_view" name="Reward" parent="menu_rewardee_all_menu" sequence="101" action="action_reward_all_view" />

    </data>
</openerp>
